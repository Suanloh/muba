# MOVA web app — client env (NEXT_PUBLIC_* only; NEVER put secrets here).
# Copy to .env.local and adjust. Defaults (shown) run against Sui testnet.
#
# MOVA runtime boundary (dev | testnet | mainnet). Controls the EXPECTED Sui
# network the app validates wallet connections against.
NEXT_PUBLIC_MOVA_ENV=testnet

# Expected Sui network (devnet | testnet | mainnet) — must agree with MOVA_ENV.
NEXT_PUBLIC_SUI_NETWORK=testnet

# Show the dev-only Demo Wallet (no browser extension needed) for local testing.
NEXT_PUBLIC_ENABLE_DEMO_WALLET=true

# Web settlement mode: simulated (default, deterministic demo) | real.
# real = attempts REAL on-chain settlement through the connected wallet
# (requires a funded testnet wallet; falls back to simulated with a reason).
NEXT_PUBLIC_SETTLEMENT_MODE=simulated
