# ==============================================================================
# MOVA — Environment Variable Spec (single source of truth)
# Full rationale & per-environment matrix: docs/environment.md
# ------------------------------------------------------------------------------
# NEVER commit real secrets. Copy this file to `.env` and fill in locally.
# `MOVA_ENV` selects the runtime boundary (dev | testnet | mainnet).
# Production target: Sui MAINNET settlement + Thetanuts V4 / Optionbook.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime boundary
# ------------------------------------------------------------------------------
# dev      -> local Supabase, Sui devnet, mocks ON, no real money
# testnet  -> Sui testnet, test tokens, real gates
# mainnet  -> Sui MAINNET, REAL funds, mocks FORBIDDEN (fail closed), all gates ON
MOVA_ENV=dev

# ------------------------------------------------------------------------------
# Supabase (backend: Postgres + Auth + Realtime + Edge Functions)
# ------------------------------------------------------------------------------
# Local dev values shown; replace with your hosted project URL/keys for testnet/mainnet.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Service-role key — SERVER-SIDE ONLY (Edge Functions). Never in the client.
SUPABASE_SERVICE_ROLE_KEY=
# For verifying Supabase JWTs inside Edge Functions.
SUPABASE_JWT_SECRET=
# Client-facing values for apps/web (Next.js).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Direct Postgres connection (migrations / local tooling only).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/mova

# ------------------------------------------------------------------------------
# AI layer — Google Gemini (proposals ONLY, never execution/compliance authority)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=1
# Hard cap on LLM tool calls / tokens per workflow
AI_MAX_TOOL_CALLS=8

# ------------------------------------------------------------------------------
# Blockchain — Sui (production target: MAINNET)
# ------------------------------------------------------------------------------
# devnet | testnet | mainnet — must match MOVA_ENV expectations
# (local node option: SUI_RPC_URL=http://127.0.0.1:9000  after `sui start`)
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
# testnet/devnet only: faucet for funding test wallets
SUI_FAUCET_URL=https://faucet.testnet.sui.io/gas
# Signer material (server-side, custodial executor). NEVER in code or logs.
SUI_PRIVATE_KEY=
SUI_MNEMONIC=
# Deployed MOVA Move package + smart wallet (set once contracts exist, Phase 2)
# Published 2026-08-28 on Sui TESTNET (chain-id 4c78adac). See contracts/mova/Published.toml.
# MOVA_PACKAGE_ID is the published package address (`published-at`).
# MOVA_SMART_WALLET_ADDRESS is the package UpgradeCap object id — MOVA's ownership
# model anchors at the user's Sui address; the UpgradeCap is the package-scoped
# control object created by the same publish transaction.
MOVA_PACKAGE_ID=0x2baa7a782929b0b2af8cbbfeb20d7f75ac89db18103ae9f2e029858156ea55c2
MOVA_SMART_WALLET_ADDRESS=0x72e285da7348564f54204eda23a1898762c085856f1f9cc51a231fd1039efe35

# ------------------------------------------------------------------------------
# Settlement mode
# ------------------------------------------------------------------------------
# simulated -> deterministic SimulatedSettlementProvider (NO real chain, NO fake
#              digests — results are marked simulated in the audit trail)
# real      -> real Sui submission; in `mainnet` this is FORCED and mocks refused
# NOTE: real settlement works on testnet NOW (SuiSettlementProvider, scripts/settle-real.ts;
# the web app attempts real via NEXT_PUBLIC_SETTLEMENT_MODE=real, default). The Move smart-
# wallet contract + mainnet validation are the remaining Phase 2 items (need the Sui CLI).
SETTLEMENT_MODE=simulated

# ------------------------------------------------------------------------------
# Sponsor integrations (behind interfaces; mocks in `mainnet` are refused)
# ------------------------------------------------------------------------------
USE_MOCKS=true
# Market data / price quotes
MARKET_DATA_PROVIDER=mock
# Hedging — Thetanuts V4 / Optionbook (on-chain options & structured products)
THETANUTS_VERSION=v4
# Thetanuts V4 OptionBook contract on Base mainnet (r12 deployment, block 45601440).
THETANUTS_OPTIONBOOK_ADDRESS=0x1bDff855d6811728acaDC00989e79143a2bdfDed
THETANUTS_NETWORK=mainnet
# Public read-only indexer (no API key needed); SDK ships these defaults baked in.
THETANUTS_API_URL=https://indexer.thetanuts.finance/api/v1/book
THETANUTS_API_KEY=
# Web realtime OptionBook feed: Base mainnet RPC for LIVE ETH/BTC ticks.
# Unset -> every tick is the labeled simulated realtime walk (dev/demo).
NEXT_PUBLIC_THETANUTS_RPC=
# Simulated sanctions/watchlist list (deterministic screening data)
SANCTIONS_LIST_PATH=./data/simulated-sanctions.json

# ------------------------------------------------------------------------------
# QR — local EMVCo decoder (no external QR API; decoding happens on-device/server)
# ------------------------------------------------------------------------------
# Reject payloads with a bad CRC-16 (fail-closed on tampered QR)
QR_STRICT_CRC=true

# ------------------------------------------------------------------------------
# Logging (see docs/conventions.md)
# ------------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
# Comma-separated fields to redact from all logs (never log secrets/PII)
LOG_REDACT_FIELDS=password,secret,apiKey,geminiApiKey,mnemonic,privateKey
# Audit events are append-only; retention for housekeeping
AUDIT_RETENTION_DAYS=1095

# ------------------------------------------------------------------------------
# Deterministic policy defaults (loaded into PolicyEngine; editable via DB later)
# ------------------------------------------------------------------------------
# Approval threshold ($) above which REVIEW/manual approval is mandatory
MANUAL_APPROVAL_THRESHOLD=25000
# Daily net cap ($) for the operating wallet
MAX_DAILY_TXN=100000

